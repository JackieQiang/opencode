{
  "name": "@opencode-ai/uniapp",
  "version": "1.0.0",
  "description": "OpenCode AI Programming Assistant - Uniapp Version for Mini Programs",
  "main": "src/main.ts",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "uni -p h5",
    "dev:app": "uni -p app-plus",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:h5": "uni build -p h5",
    "build:app": "uni build -p app-plus",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .vue,.ts,.tsx,.js,.jsx,.mjs,.cjs",
    "lint:fix": "eslint src --ext .vue,.ts,.tsx,.js,.jsx,.mjs,.cjs --fix",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@dcloudio/uni-app": "^3.0.0-3090920231223",
    "@dcloudio/uni-components": "^3.0.0-3090920231223",
    "@dcloudio/uni-h5": "^3.0.0-3090920231223",
    "@dcloudio/uni-mp-alipay": "^3.0.0-3090920231223",
    "@dcloudio/uni-mp-weixin": "^3.0.0-3090920231223",
    "@hyoga/uni-socket.io": "^1.0.6",
    "@pinia/nuxt": "^0.5.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "^3.0.0-3090920231223",
    "@dcloudio/uni-cli-shared": "^3.0.0-3090920231223",
    "@dcloudio/uni-stacktracey": "^3.0.0-3090920231223",
    "@dcloudio/vite-plugin-uni": "^3.0.0-3090920231223",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "prettier": "^3.2.4",
    "sass": "^1.70.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vue-tsc": "^1.8.27"
  }
}
